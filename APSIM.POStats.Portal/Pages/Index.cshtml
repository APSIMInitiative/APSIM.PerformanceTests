        <div id="tab-3" class="tab-panel">
            @if (@Model.PullRequest.AcceptedPullRequest != null)
            {
                <table class="stats-table">
                    @foreach (ApsimFileComparison file in PullRequestFunctions.GetFileComparisons(Model.PullRequest))
                    {
                        <tr></tr>
                        <tr>
                            <td class="stats-table-heading"><b>@Html.Raw(file.CombinedName)</b></td>
                            <td class="stats-table-heading">&nbsp;</td>
                            <td class="stats-table-heading">&nbsp;</td>
                            <td class="stats-table-heading">&nbsp;</td>

                            <td class="stats-table-heading" style="text-align:center">Proto</td>
                            <td class="stats-table-heading" style="text-align:center">(Valid)</td>
                            <td class="stats-table-heading">&nbsp;</td>
                            <td class="stats-table-heading">&nbsp;</td>

                            <td class="stats-table-heading" style="text-align:center">Proto</td>
                            <td class="stats-table-heading" style="text-align:center">(Valid)</td>
